# Copy to .env and keep the real file outside version control.
# Local HTTP is accepted only for loopback hosts. Public deployments must use
# the HTTPS origin served by the VPS; the application itself serves plain HTTP.
BASE_URL=http://localhost:3042

# The only published host port. Check it is free on jarvis before deployment.
APP_PORT=3042

# Optional immutable release tag for deployments using a prebuilt image.
APP_IMAGE=bikerskz:0.1.0

# Generate a unique URL-safe password, for example: openssl rand -hex 32
# Use letters/digits only here because this value is also part of DATABASE_URL.
POSTGRES_PASSWORD=

# Required to serve the app. Migrations do not send messages or need this token.
# Obtain the production Telegram Gateway token from your Gateway account.
TELEGRAM_GATEWAY_TOKEN=

# Shared daily verification-send budget, in addition to per-phone limits.
OTP_DAILY_BUDGET=1000

# Optional comma-separated exact proxy peer CIDRs, e.g. a VPS WireGuard /32.
# Empty ignores X-Forwarded-For. Allow only real peers you control; do not trust
# all private networks. BASE_URL still governs origin and cookie security.
TRUSTED_PROXY_CIDRS=

# Optional opt-in browser notifications. The inbox works without these.
# Generate once: api push-keys --output /private/tmp/bikerskz-push.env --subject mailto:you@example.com
# Keep the matching pair stable and private; transfer it into deployment secrets.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# For running Go directly instead of Compose, also export DATABASE_URL, PORT,
# WEB_DIST_DIR and MEDIA_DIR. Compose sets these internally; it never publishes
# PostgreSQL. BASE_URL must match the browser origin used to access the app.
